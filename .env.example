# Copy to .env and fill in. .env is gitignored.

# Hard spend ceiling per run, in USD. Runs abort before any API call if the
# estimate exceeds this, and abort mid-run if actual spend reaches it.
TAPNOW_MAX_SPEND_USD=5.00

# Text: Anthropic (claude-fable-5)
ANTHROPIC_API_KEY=

# Image: Seedream V4 via fal.ai (the default workflow uses this).
# Create at fal.ai → dashboard → Keys.
FAL_KEY=

# Image (alternative): Seedream via BytePlus ModelArk / Volcano Engine Ark —
# only if your region supports it. Default base URL is BytePlus
# ap-southeast-1; for a CN Volcano Engine key set:
#   ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_API_KEY=

# Video: Kling image-to-video. Create the key in the Kling AI console
# ("+ Create a new API Key") — the current API uses a plain API key,
# not the legacy access/secret key pair.
KLING_API_KEY=
